---
import OpportunityRow from '~/components/islands/OpportunityRow';
import ForYouFilter from '~/components/islands/ForYouFilter';
import { L, t, weekdayName } from '~/i18n';
import { unitById } from '~/data';
import { toIcsEvent } from '~/lib/ics';
import { mailto } from '~/lib/entities';
import { latinRuns } from '~/lib/latinRuns';
import type { EventItem, Lang } from '~/lib/model';

interface Props {
  lang: Lang;
  events: EventItem[];
  /** ISO date treated as today for the prototype. */
  today: string;
  headingId?: string;
  limit?: number;
  /** The list page carries its own "my favorites only" chip; the home band drives the home. */
  filter?: boolean;
  /** The home's short list: title and date, linking to the list page where the actions are. */
  compact?: boolean;
}
const { lang, events, today, headingId = 'opp-title', limit, filter = false, compact = false } = Astro.props;
const dayMs = 86_400_000;
const t0 = new Date(`${today}T12:00:00+03:00`).getTime();
const rows = events
  .filter((e) => e.opportunity)
  .map((e) => ({ e, daysLeft: Math.round((new Date(`${e.start.slice(0, 10)}T12:00:00+03:00`).getTime() - t0) / dayMs) }))
  .sort((a, b) => a.e.start.localeCompare(b.e.start))
  .slice(0, limit ?? 99);
---
<section class="opp sec" id="opp" aria-labelledby={headingId}>
  <div class="wrap">
    <div class="opp-head">
      <h2 id={headingId}>{t(lang, 'opp.title')}</h2>
      {!compact && <p>{t(lang, 'opp.lead')}</p>}
      {filter && <ForYouFilter client:idle lang={lang} />}
    </div>
    <div class="rows" data-fy-list data-fy-hide={filter || undefined}>
      <p class="favs-empty" data-fy-empty hidden>{t(lang, 'foryou.emptyList')}</p>
      {rows.map(({ e, daysLeft }) => {
        const u = unitById(e.unitId);
        if (compact) {
          return (
            <article class="row compact" data-fy data-units={e.unitId}>
              <div class="d">
                {Number(e.start.slice(8, 10))}
                <small>{weekdayName(lang, e.start)}</small>
              </div>
              <div>
                <span class="fy-mark" aria-hidden="true">{t(lang, 'foryou.mark')}</span>
                <h3><a href={`/${lang}/opportunities/`}>{latinRuns(L(e.title, lang)).map((r) => (r.nowrap ? <span class="nowrap">{r.text}</span> : r.text))}</a></h3>
              </div>
            </article>
          );
        }
        return (
          <OpportunityRow
            client:visible
            lang={lang}
            event={toIcsEvent(e)}
            eventId={e.id}
            unitId={e.unitId}
            day={Number(e.start.slice(8, 10))}
            weekday={weekdayName(lang, e.start)}
            title={L(e.title, lang)}
            organizer={L(u.name, lang)}
            askHref={mailto(u.email ?? 'dsa-mag@kfupm.edu.sa', L(e.title, lang))}
            daysLeft={daysLeft}
            startIso={e.start.slice(0, 10)}
          />
        );
      })}
    </div>
    {compact && <p class="opp-all"><a href={`/${lang}/opportunities/`}>{t(lang, 'opp.all')}</a></p>}
  </div>
</section>
