---
import { Image } from 'astro:assets';
import { L, t, tp } from '~/i18n';
import { photo, hasPhoto } from '~/lib/photos';
import { personById } from '~/data';
import type { Lang, Story } from '~/lib/model';

interface Props {
  lang: Lang;
  big: Story;
  side: Story[];
}
const { lang, big, side } = Astro.props;
const href = (s: Story) => `/${lang}/issue/${s.issue}/${s.slug}/`;
const bigAuthor = big.authorId ? L(personById(big.authorId).name, lang) : null;
const minutes = tp(lang, 'voices.minutes', big.readingMinutes);
---
<section class="voices sec" id="voices" aria-labelledby="voices-title">
  <div class="wrap">
    <h2 id="voices-title">{t(lang, 'voices.title')}</h2>
    <div class="voices-grid">
      <article class="vo big" data-fy data-nodim data-units={big.unitIds.join(',')} data-section={big.section}>
        <span class="fy-mark" aria-hidden="true">{t(lang, 'foryou.mark')}</span>
        {hasPhoto(big.photo) && <Image class="fast-photo" src={photo(big.photo)} alt={L(big.photoAlt ?? big.title, lang)} widths={[640, 1000]} sizes="(max-width: 1023px) 100vw, 50vw" loading="lazy" />}
        <h3><a href={href(big)}>{L(big.title, lang)}</a></h3>
        <p>{bigAuthor ? `${bigAuthor}${lang === 'ar' ? '، ' : ', '}${minutes}` : minutes}</p>
        <p>{L(big.summary, lang)}</p>
        <div class="act-row">
          <a class="btn sm" href={href(big)}>{t(lang, 'voices.readStory')}</a>
        </div>
      </article>
      <ul class="title-links">
        {side.map((s) => (
          <li data-fy data-units={s.unitIds.join(',')} data-section={s.section}>
            <span class="fy-mark" aria-hidden="true">{t(lang, 'foryou.mark')}</span>
            <a href={href(s)}>{L(s.title, lang)}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
