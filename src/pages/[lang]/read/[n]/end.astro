---
import '~/styles/reader-links.css';
import Base from '~/layouts/Base.astro';
import TopBar from '~/components/TopBar.astro';
import Footer from '~/components/Footer.astro';
import IssueNav from '~/components/IssueNav.astro';
import EndContents from '~/components/islands/EndContents';
import Onboarding from '~/components/islands/Onboarding';
import sources from '../../../../../scripts/archive-sources.json';
import { currentIssue, loadAll, storiesOf } from '~/data';
import { L, t, tp } from '~/i18n';
import { SECTIONS, type ArchiveEntry, type Lang } from '~/lib/model';
import { adjacentIssues, groupBySection, hasPages as onDisk, pageHref, remotePdfUrl } from '~/lib/reader';

export function getStaticPaths() {
  const b = loadAll();
  return (['ar', 'en'] as Lang[]).flatMap((lang) => b.archive.map((a) => ({ params: { lang, n: String(a.number) }, props: { entry: a } })));
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props as { entry: ArchiveEntry };
const bundle = loadAll();
const unitList = bundle.units.map((u) => ({ id: u.id, name: u.name }));
const current = currentIssue();
const n = entry.number;
const stories = storiesOf(n);
const hasPages = onDisk(entry);
const remote = hasPages ? null : remotePdfUrl(sources, n);
const { prev, next } = adjacentIssues(bundle.archive.map((a) => a.number), n);
const sectionName = (id: string) => L(SECTIONS.find((s) => s.id === id)!.name, lang);
const groups = groupBySection(stories).map((g) => ({
  id: g.section,
  name: sectionName(g.section),
  // The file is where reading happens; only a web-only story has its own page to go to.
  stories: g.stories.map((s) => ({ href: s.pdfPage && hasPages ? pageHref(lang, s.issue, s.pdfPage, s.id) : `/${lang}/issue/${s.issue}/${s.slug}/`, title: L(s.title, lang), minutes: tp(lang, 'voices.minutes', s.readingMinutes) })),
}));
const place = L(bundle.pickup[0].name, lang);
const title = t(lang, 'read.endTitle', { n });
---
<Base lang={lang} title={`${title} | ${t(lang, 'site.name')}`} description={title}>
  <TopBar lang={lang} issue={current.number} />
  <main id="main" class="wrap reader reader-end">
    <header class="reader-head">
      <h1>{title}</h1>
      {groups.length > 0 && <p class="reader-line">{t(lang, 'read.endLead')}</p>}
      {groups.length === 0 && hasPages && <p class="reader-line">{t(lang, 'read.endLeadPages', { pages: tp(lang, 'arch.pages', entry.pages) })}</p>}
      {groups.length === 0 && !hasPages && <p class="reader-line">{t(lang, 'read.endLeadRemote')}</p>}
      <p class="reader-links">
        <a href={`/${lang}/read/${n}/`}>{t(lang, 'read.endBack')}</a>
        {remote && <a href={remote} rel="noopener">{t(lang, 'arch.download')}</a>}
      </p>
    </header>

    {groups.length > 0 && <EndContents client:load lang={lang} issue={n} groups={groups} />}

    <IssueNav lang={lang} prev={prev} next={next} />

    <section class="end-hard" aria-labelledby="end-hard-title">
      <h2 id="end-hard-title">{t(lang, 'hard.title')}</h2>
      <p>{n === current.number ? t(lang, 'hard.endCurrent', { n, place }) : t(lang, 'hard.endOther', { n: current.number, place })}</p>
      <a class="btn sm" href={`/${lang}/hard-copy/`}>{t(lang, 'hard.more')}</a>
    </section>
  </main>
  <Onboarding client:idle lang={lang} issue={current.number} units={unitList} />
  <Footer lang={lang} />
</Base>
